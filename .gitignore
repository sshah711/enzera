# Python / environments
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Secrets - never commit
.env
.streamlit/secrets.toml

# Local runtime files
*.db
mlruns/
*.log

# Raw SGCC data is too large for GitHub (175 MB). Download it again from
# https://github.com/henryRDlab/ElectricityTheftDetection into data/raw/
data/raw/*
!data/raw/.gitkeep
*.zip
*.z01
*.z02

# NOTE: models/, reports/, data/demo/ and data/samples/ are deliberately committed:
# the Render backend and Streamlit frontend are built from them.
