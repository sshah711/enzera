# Copy to .env (never commit .env). All settings are optional.

# --- frontend ---
BACKEND_URL=http://localhost:8000

# --- backend ---
# Protects the data endpoints with an X-API-Key header. If set, set the same value on the frontend.
API_KEY=
# PostgreSQL keeps inspection cases when the free Render instance restarts (e.g. a free Neon or Render Postgres DB).
# Leave empty to use SQLite (file backend/enzera.db, or DB_PATH).
DATABASE_URL=
# Signs login tokens. Set a long random value in production so logins survive restarts.
SECRET_KEY=
# Accounts as name:password:role, comma-separated (roles: inspector, manager).
# If empty, the demo accounts from the README are used - change them for any real use.
USERS=
